# Helio configuration — placeholders only.
#
# IMPORTANT: This file must NEVER contain OKX API keys, secrets, passphrases,
# private keys, or wallet seeds. OKX credentials are managed exclusively by
# the OKX Agent Trade Kit's own local credential store — Helio never reads,
# stores, or accepts them. See docs/OKX_SETUP.md.

# "simulation" (default, safe) or "live" (requires risk_config.yaml: allow_live: true)
HELIO_MODE=simulation

# debug | info | warning | error
HELIO_LOG_LEVEL=info

# Path to the active risk config (copy from backend/config/risk_config.example.yaml)
HELIO_RISK_CONFIG_PATH=backend/config/risk_config.yaml

# Where the local learning-event SQLite database lives
HELIO_DB_PATH=backend/helio.sqlite3

# Local-only FastAPI service (bind stays 127.0.0.1 regardless of this port)
HELIO_SERVICE_HOST=127.0.0.1
HELIO_SERVICE_PORT=8787
